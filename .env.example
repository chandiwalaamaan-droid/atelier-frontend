# Backend API URL (required).
# Set this to your deployed Render backend URL, e.g.:
# BACKEND_API_URL=https://atelier-backend-eowg.onrender.com
#
# BACKEND_API_URL is server-side only and is what the /api proxy uses in
# production. NEXT_PUBLIC_API_URL is exposed to the browser and is used as
# a fallback if BACKEND_API_URL is unset. Set both to the same value.
BACKEND_API_URL=
NEXT_PUBLIC_API_URL=

# Google OAuth Client ID (optional)
# Leave unset to hide the Google sign-in button.
# Must match the backend's GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay Key ID (optional)
# Only needed once billing goes live. Leave unset for now.
NEXT_PUBLIC_RAZORPAY_KEY_ID=